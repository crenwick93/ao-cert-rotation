{
  "schema_version": "2.0.0",
  "name": "Cert Lifecycle (Manual)",
  "description": "Manual-trigger version for live demos.",
  "triggers": [
    {
      "id": "trigger_manual",
      "type": "manual_trigger",
      "name": "Manual Cert Alert",
      "parameters": {
        "input_schema": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "description": "Hostname of the service with the expiring cert"
            },
            "service": {
              "type": "string",
              "description": "Service name (nginx or api-server)"
            },
            "cert_type": {
              "type": "string",
              "description": "Certificate type (pem or java_keystore)"
            },
            "port": {
              "type": "integer",
              "description": "Port the service listens on"
            },
            "status": {
              "type": "string",
              "description": "Certificate status (critical, expired, warning, valid)"
            },
            "days_remaining": {
              "type": "integer",
              "description": "Days until certificate expires"
            },
            "expiry_date": {
              "type": "string",
              "description": "Certificate expiry date"
            },
            "issuer": {
              "type": "string",
              "description": "Certificate issuer"
            }
          }
        }
      },
      "position": {
        "x": 0,
        "y": 400
      }
    }
  ],
  "nodes": [
    {
      "id": "cert_type_switch",
      "type": "switch",
      "name": "Route by Cert Type",
      "parameters": {
        "cases": [
          {
            "port": "case_pem",
            "label": "PEM (non-invasive)",
            "condition": "${trigger.cert_type} == 'pem'"
          },
          {
            "port": "case_keystore",
            "label": "Java Keystore (invasive)",
            "condition": "${trigger.cert_type} == 'java_keystore'"
          }
        ]
      },
      "position": {
        "x": 600,
        "y": 400
      }
    },
    {
      "id": "create_change_pem",
      "type": "aap_job_template",
      "name": "Standard Change (PEM)",
      "parameters": {
        "job_template_name": "Manage SNOW Change Request",
        "organization_name": "Default",
        "extra_vars": {
          "action": "create_standard",
          "change_template_name": "Certificate Renewal - PEM",
          "cmdb_ci_name": "citizen-portal-web",
          "short_description": "Certificate renewal: ${trigger.service} on ${trigger.host} (PEM - reload, zero downtime)",
          "description": "Automated PEM certificate renewal.\n\nHost: ${trigger.host}\nService: ${trigger.service}\nPort: ${trigger.port}\nCert Type: PEM\nDays Remaining: ${trigger.days_remaining}\nExpiry: ${trigger.expiry_date}\n\nService impact: nginx reload (zero downtime)."
        }
      },
      "position": {
        "x": 1200,
        "y": 150
      }
    },
    {
      "id": "renew_pem",
      "type": "aap_job_template",
      "name": "Renew PEM Certificate",
      "parameters": {
        "job_template_name": "Renew Certificate",
        "organization_name": "Default",
        "extra_vars": {
          "cert_domain": "${trigger.host}"
        }
      },
      "position": {
        "x": 1800,
        "y": 150
      }
    },
    {
      "id": "validate_pem",
      "type": "aap_job_template",
      "name": "Validate PEM Renewal",
      "parameters": {
        "job_template_name": "Validate Cert Renewal",
        "organization_name": "Default",
        "extra_vars": {
          "cert_domain": "${trigger.host}",
          "validation_port": "${trigger.port}"
        }
      },
      "position": {
        "x": 2400,
        "y": 150
      }
    },
    {
      "id": "close_change_pem",
      "type": "aap_job_template",
      "name": "Close Change (PEM)",
      "parameters": {
        "job_template_name": "Manage SNOW Change Request",
        "organization_name": "Default",
        "extra_vars": {
          "action": "close",
          "cr_sys_id": "${create_change_pem.artifacts.cr_sys_id}",
          "close_notes": "Status: PEM certificate renewed successfully\nValidation: ${validate_pem.artifacts.validation_result}\nNew Expiry: ${validate_pem.artifacts.cert_expiry}\nDays Remaining: ${validate_pem.artifacts.cert_days_remaining}\nSubject: ${validate_pem.artifacts.cert_subject}",
          "task_close_summary": "Validation: ${validate_pem.artifacts.validation_result}. New expiry: ${validate_pem.artifacts.cert_expiry}. Days remaining: ${validate_pem.artifacts.cert_days_remaining}.",
          "task_descriptions": {
            "implementation": "Certificate renewed by AAP.\nJob output: https://aaponprem.chrislab.dev/execution/jobs/playbook/${renew_pem.artifacts.renewal_job_id}/output",
            "testing": "Post-renewal TLS validation by AAP.\nJob output: https://aaponprem.chrislab.dev/execution/jobs/playbook/${validate_pem.artifacts.validation_job_id}/output"
          }
        }
      },
      "position": {
        "x": 3000,
        "y": 150
      }
    },
    {
      "id": "create_change_keystore",
      "type": "aap_job_template",
      "name": "Standard Change (Keystore)",
      "parameters": {
        "job_template_name": "Manage SNOW Change Request",
        "organization_name": "Default",
        "extra_vars": {
          "action": "create_standard",
          "change_template_name": "Certificate Renewal - Java Keystore",
          "cmdb_ci_name": "citizen-portal-api",
          "cr_assignment_group": "Application Services",
          "short_description": "Certificate renewal: ${trigger.service} on ${trigger.host} (Java keystore - RESTART REQUIRED)",
          "description": "Java keystore certificate renewal requiring service restart.\n\nHost: ${trigger.host}\nService: ${trigger.service}\nPort: ${trigger.port}\nCert Type: Java Keystore\nDays Remaining: ${trigger.days_remaining}\nExpiry: ${trigger.expiry_date}\n\nWARNING: This renewal requires a full Tomcat restart. Brief downtime expected."
        }
      },
      "position": {
        "x": 1200,
        "y": 650
      }
    },
    {
      "id": "approval_gate",
      "type": "approval",
      "name": "Awaiting Implementation",
      "parameters": {
        "description": "Java keystore renewal requires a Tomcat restart (brief downtime).\n\nCR: ${create_change_keystore.artifacts.cr_number}\nHost: ${trigger.host}\nService: ${trigger.service}\nDays Remaining: ${trigger.days_remaining}\n\nReview the CR in ServiceNow, schedule the maintenance window, then move to Implement. EDA will auto-approve this gate.",
        "timeout": 0
      },
      "position": {
        "x": 1800,
        "y": 650
      }
    },
    {
      "id": "renew_keystore",
      "type": "aap_job_template",
      "name": "Renew Keystore Certificate",
      "parameters": {
        "job_template_name": "Renew Keystore Certificate",
        "organization_name": "Default",
        "extra_vars": {
          "cert_domain": "${trigger.host}"
        }
      },
      "position": {
        "x": 3000,
        "y": 650
      }
    },
    {
      "id": "validate_keystore",
      "type": "aap_job_template",
      "name": "Validate Keystore Renewal",
      "parameters": {
        "job_template_name": "Validate Cert Renewal",
        "organization_name": "Default",
        "extra_vars": {
          "cert_domain": "${trigger.host}",
          "validation_port": "${trigger.port}"
        }
      },
      "position": {
        "x": 3600,
        "y": 650
      }
    },
    {
      "id": "close_change_keystore",
      "type": "aap_job_template",
      "name": "Close Change (Keystore)",
      "parameters": {
        "job_template_name": "Manage SNOW Change Request",
        "organization_name": "Default",
        "extra_vars": {
          "action": "close",
          "cr_sys_id": "${create_change_keystore.artifacts.cr_sys_id}",
          "close_notes": "Status: Java keystore certificate renewed successfully (Tomcat restarted)\nValidation: ${validate_keystore.artifacts.validation_result}\nNew Expiry: ${validate_keystore.artifacts.cert_expiry}\nDays Remaining: ${validate_keystore.artifacts.cert_days_remaining}\nSubject: ${validate_keystore.artifacts.cert_subject}",
          "task_close_summary": "Validation: ${validate_keystore.artifacts.validation_result}. New expiry: ${validate_keystore.artifacts.cert_expiry}. Days remaining: ${validate_keystore.artifacts.cert_days_remaining}.",
          "task_descriptions": {
            "implementation": "Java keystore certificate renewed by AAP. Tomcat restarted.\nJob output: https://aaponprem.chrislab.dev/execution/jobs/playbook/${renew_keystore.artifacts.renewal_job_id}/output",
            "testing": "Post-renewal TLS validation by AAP.\nJob output: https://aaponprem.chrislab.dev/execution/jobs/playbook/${validate_keystore.artifacts.validation_job_id}/output"
          }
        }
      },
      "position": {
        "x": 4200,
        "y": 650
      }
    },
    {
      "id": "rejection_handler",
      "type": "aap_job_template",
      "name": "Update CR: Rejected",
      "parameters": {
        "job_template_name": "Manage SNOW Change Request",
        "organization_name": "Default",
        "extra_vars": {
          "action": "update",
          "cr_sys_id": "${create_change_keystore.artifacts.cr_sys_id}",
          "work_notes": "Change request rejected. Certificate on ${trigger.host}:${trigger.port} still has ${trigger.days_remaining} days remaining. Manual renewal required before expiry."
        }
      },
      "position": {
        "x": 3000,
        "y": 900
      }
    }
  ],
  "edges": [
    {
      "from": "trigger_manual",
      "to": "cert_type_switch"
    },
    {
      "from": "cert_type_switch",
      "to": "create_change_pem",
      "from_port": "case_pem"
    },
    {
      "from": "create_change_pem",
      "to": "renew_pem"
    },
    {
      "from": "renew_pem",
      "to": "validate_pem"
    },
    {
      "from": "validate_pem",
      "to": "close_change_pem"
    },
    {
      "from": "cert_type_switch",
      "to": "create_change_keystore",
      "from_port": "case_keystore"
    },
    {
      "from": "create_change_keystore",
      "to": "approval_gate"
    },
    {
      "from": "approval_gate",
      "to": "renew_keystore",
      "from_port": "approved"
    },
    {
      "from": "approval_gate",
      "to": "rejection_handler",
      "from_port": "rejected"
    },
    {
      "from": "renew_keystore",
      "to": "validate_keystore"
    },
    {
      "from": "validate_keystore",
      "to": "close_change_keystore"
    }
  ]
}